{
  "name": "dsh-image-budget",
  "version": "2.0.2",
  "description": "DSH 图片预算守卫：读图超预算就地降采样、上下文溢出时按字节淘汰图片、让「一张图顶半个窗口」不再炸会话。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./plan": "./lib/plan.js",
    "./image": "./lib/image.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "image",
    "context",
    "compaction",
    "token-budget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yin1895/dsh-image-budget.git"
  },
  "homepage": "https://github.com/yin1895/dsh-image-budget#readme",
  "bugs": {
    "url": "https://github.com/yin1895/dsh-image-budget/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:report": "node test/run.mjs --report"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3"
}
